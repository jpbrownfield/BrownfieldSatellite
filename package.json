{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "description": "Brownfield Satellite",
  "author": "Jon Brownfield Jr.",
  "type": "module",
  "main": "http://localhost:5173",
  "node-remote": "<all_urls>",
  "user-agent": "Mozilla/5.0 (Web0S; Linux/SmartTV) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/114.0.5735.199 Safari/537.36 SmartTV/8.3.0 (V8.3.0-22)",
  "chromium-args": "--remote-debugging-port=9222 --remote-allow-origins=* --disable-blink-features=AutomationControlled",
  "window": {
    "width": 1280,
    "height": 720,
    "title": "Brownfield Satellite"
  },
  "scripts": {
    "dev": "concurrently \"vite --port 5173\" \"wait-on http://localhost:5173 && nw .\"",
    "build": "vite build",
    "build:exe": "node scripts/build-nw.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "puppeteer-core": "^24.42.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/nw.js": "^0.92.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.9.0",
    "nw": "^0.111.0",
    "nw-builder": "^4.17.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "vite": "^7.0.0",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  }
}